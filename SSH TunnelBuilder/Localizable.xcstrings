          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haz copias de seguridad de tus conexiones y restáuralas con un archivo `.sshtunnels` cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
