    "How long a single authentication is remembered. Within this window, reconnecting won't ask again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie lange eine einzelne Authentifizierung gemerkt wird. Innerhalb dieses Zeitfensters wird beim erneuten Verbinden nicht noch einmal gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long a single authentication is remembered. Within this window, reconnecting won't ask again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cuánto tiempo se recuerda una única autenticación. Dentro de este intervalo, al volver a conectarte no se te preguntará de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Durée pendant laquelle une authentification unique reste mémorisée. Pendant cette période, une reconnexion ne la redemandera pas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor lenge én enkelt autentisering huskes. Innenfor dette tidsvinduet blir du ikke spurt igjen når du kobler til på nytt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Por quanto tempo uma única autenticação é memorizada. Dentro desse período, ao reconectar você não precisará autenticar novamente."
          }
        }
      }
    },
    "iCloud sync" : {
      "comment" : "A description of how connections sync between devices.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud-Synchronisierung"
          }
        },
        "en" : {
          "stringUnit" : {
