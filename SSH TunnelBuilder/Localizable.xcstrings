    "RSA and DSA are **not** supported. DSA was removed from OpenSSH 10.0; RSA support depends on upstream work in NIOSSH that isn't yet available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RSA und DSA werden **nicht** unterstützt. DSA wurde in OpenSSH 10.0 entfernt; die Unterstützung für RSA hängt von Upstream-Arbeiten in NIOSSH ab, die noch nicht verfügbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA and DSA are **not** supported. DSA was removed from OpenSSH 10.0; RSA support depends on upstream work in NIOSSH that isn't yet available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RSA y DSA **no** son compatibles. DSA se eliminó de OpenSSH 10.0; la compatibilidad con RSA depende de cambios en el propio NIOSSH que aún no están disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RSA et DSA ne sont **pas** pris en charge. DSA a été supprimé d’OpenSSH 10.0, et la prise en charge de RSA dépend de travaux en amont dans NIOSSH qui ne sont pas encore disponibles."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA og DSA er **ikke** støttet. DSA ble fjernet i OpenSSH 10.0, og støtte for RSA avhenger av oppstrømsarbeid i NIOSSH som ennå ikke er tilgjengelig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RSA e DSA **não** são compatíveis. O DSA foi removido do OpenSSH 10.0; a compatibilidade com RSA depende de mudanças no próprio NIOSSH que ainda não estão disponíveis."
          }
        }
      }
    },
