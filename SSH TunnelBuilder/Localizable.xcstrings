    },
    "Both Macs must be signed in to the same iCloud account with iCloud Drive enabled. Sync can take a moment after the first save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beide Macs müssen bei demselben iCloud-Account angemeldet sein, und iCloud Drive muss aktiviert sein. Die Synchronisierung kann nach dem ersten Sichern einen Moment dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both Macs must be signed in to the same iCloud account with iCloud Drive enabled. Sync can take a moment after the first save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ambos Macs deben tener la sesión iniciada en la misma cuenta de iCloud, con iCloud Drive activado. La sincronización puede tardar un momento después de guardar por primera vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les deux Mac doivent être connectés au même compte iCloud, avec iCloud Drive activé. La synchronisation peut prendre un moment après le premier enregistrement."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge Mac-maskinene må være logget på samme iCloud-konto, og iCloud Drive må være slått på. Synkroniseringen kan ta litt tid etter første lagring."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ambos os Macs devem estar com sessão iniciada na mesma conta do iCloud, com o iCloud Drive ativado. A sincronização pode demorar um pouco após salvar pela primeira vez."
          }
        }
      }
    },
