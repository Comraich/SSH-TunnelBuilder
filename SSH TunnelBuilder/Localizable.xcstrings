    "RSA and DSA are **not** supported. DSA was removed from OpenSSH 10.0; RSA support depends on upstream work in NIOSSH that isn't yet available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RSA und DSA werden **nicht** unterstützt. DSA wurde in OpenSSH 10.0 entfernt; die Unterstützung für RSA hängt von Upstream-Arbeiten in NIOSSH ab, die noch nicht verfügbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA and DSA are **not** supported. DSA was removed from OpenSSH 10.0; RSA support depends on upstream work in NIOSSH that isn't yet available."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA og DSA er **ikke** støttet. DSA ble fjernet i OpenSSH 10.0, og støtte for RSA avhenger av oppstrømsarbeid i NIOSSH som ennå ikke er tilgjengelig."
          }
        }
      }
    },
