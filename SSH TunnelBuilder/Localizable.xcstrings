          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør hver gang"
          }
        }
      }
    },
    "Back up and restore your connections with an encrypted `.sshtunnels` file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichere deine Verbindungen mit einer verschlüsselten `.sshtunnels`-Datei und stelle sie wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up and restore your connections with an encrypted `.sshtunnels` file."
