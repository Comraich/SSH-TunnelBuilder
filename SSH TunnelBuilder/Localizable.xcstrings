    "Warning: Key appears unencrypted. Prefer an encrypted PEM (PKCS#8) with a passphrase." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Key appears unencrypted. Prefer an encrypted PEM (PKCS#8) with a passphrase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avertissement : la clé semble ne pas être chiffrée. Préférez un PEM chiffré (PKCS#8) avec une phrase secrète."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Nøkkelen ser ut til å være ukryptert. Bruk helst en kryptert PEM (PKCS#8) med en passfrase."
          }
        }
      }
    },
    "Welcome. SSH Tunnel Builder sets up local **SSH port forwarding** so you can reach services on a remote network through an SSH connection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome. SSH Tunnel Builder sets up local **SSH port forwarding** so you can reach services on a remote network through an SSH connection."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bienvenue. SSH Tunnel Builder met en place une **redirection de port SSH** locale afin que vous puissiez atteindre des services d’un réseau distant via une connexion SSH."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen. SSH Tunnel Builder setter opp lokal **SSH-portvideresending** slik at du kan nå tjenester på et eksternt nettverk via en SSH-tilkobling."
          }
        }
      }
    },
    "What's inside" : {
