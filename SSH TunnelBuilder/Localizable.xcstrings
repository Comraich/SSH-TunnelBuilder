          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les clés OpenSSH Ed25519/ECDSA sont prises en charge, y compris celles protégées par une phrase secrète (aes-ctr, aes-cbc, aes-gcm). Saisissez la phrase secrète ci-dessous si la clé est chiffrée."
          }
        },
