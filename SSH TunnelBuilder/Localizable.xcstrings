            "value" : "**Verbindung hinzufügen** — klicke in der Seitenleiste auf **+**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Add a connection** — click **+** in the sidebar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Añade una conexión** — haz clic en **+** en la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**Ajouter une connexion** — cliquez sur **+** dans la barre latérale."
          }
        },
        "nb" : {
          "stringUnit" : {
