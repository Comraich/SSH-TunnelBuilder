    "Warning: Key appears unencrypted. Prefer an encrypted PEM (PKCS#8) with a passphrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Achtung: Der Schlüssel scheint unverschlüsselt zu sein. Verwende besser ein verschlüsseltes PEM (PKCS#8) mit einer Passphrase."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warning: Key appears unencrypted. Prefer an encrypted PEM (PKCS#8) with a passphrase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aviso: la clave parece estar sin cifrar. Es preferible usar un PEM cifrado (PKCS#8) con una frase de contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avertissement : la clé semble ne pas être chiffrée. Préférez un PEM chiffré (PKCS#8) avec une phrase secrète."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Nøkkelen ser ut til å være ukryptert. Bruk helst en kryptert PEM (PKCS#8) med en passfrase."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aviso: a chave parece não estar criptografada. Prefira um PEM criptografado (PKCS#8) com uma frase-senha."
          }
        }
      }
    },
    "Welcome. SSH TunnelBuilder sets up local **SSH port forwarding** so you can reach services on a remote network through an SSH connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Willkommen. SSH TunnelBuilder richtet lokale **SSH-Portweiterleitung** ein, damit du Dienste in einem Remote-Netzwerk über eine SSH-Verbindung erreichen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome. SSH TunnelBuilder sets up local **SSH port forwarding** so you can reach services on a remote network through an SSH connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Te damos la bienvenida. SSH TunnelBuilder configura el **reenvío de puertos SSH** local para que puedas acceder a servicios de una red remota a través de una conexión SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bienvenue. SSH TunnelBuilder met en place une **redirection de port SSH** locale afin que vous puissiez atteindre des services d’un réseau distant via une connexion SSH."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen. SSH TunnelBuilder setter opp lokal **SSH-portvideresending** slik at du kan nå tjenester på et eksternt nettverk via en SSH-tilkobling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Boas-vindas. O SSH TunnelBuilder configura o **encaminhamento de portas SSH** local para que você possa acessar serviços em uma rede remota por meio de uma conexão SSH."
          }
        }
      }
    },
    "What's inside" : {
      "comment" : "A heading for the content of the file.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Inhalt der Datei"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's inside"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contenido del archivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Contenu du fichier"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva filen inneholder"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
